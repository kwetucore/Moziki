# ---------------------------------------------------------------------------
# Copy to .env and adjust. These values are for local development; production
# deployments must provide real secrets through the environment/secret store.
# ---------------------------------------------------------------------------

# PostgreSQL (matches scripts/dev-db.sh and docker-compose.yml)
MOZIKI_DB_URL=jdbc:postgresql://127.0.0.1:5434/moziki
MOZIKI_DB_USER=moziki
MOZIKI_DB_PASSWORD=moziki
MOZIKI_DB_TEST_URL=jdbc:postgresql://127.0.0.1:5434/moziki_test

# Generate with: openssl rand -base64 48
MOZIKI_JWT_SECRET=change-me-to-at-least-32-random-bytes-before-any-real-deployment

# Seed the demo cooperative and users (NEVER enable in production)
MOZIKI_DEMO_DATA=true
MOZIKI_DEMO_PASSWORD=Moziki2026!
# Daily cash counts may backfill recent days, but never future dates.
# A completed day locks at this local hour the next morning.
MOZIKI_RECONCILIATION_LOCK_HOUR=12
MOZIKI_RECONCILIATION_BACKFILL_DAYS=7
# Proof photos/receipts (local directory, 5 MB per file).
MOZIKI_EVIDENCE_DIR=./data/evidence
MOZIKI_EVIDENCE_MAX_BYTES=5242880

# Comma-separated browser origins allowed to call the API
MOZIKI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
